FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0

# MySQL settings. Create the database first using schema.sql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=vehicleconnect_qr

# QR origin. For cloud hosting, set this to the stable HTTPS domain from your host.
BASE_URL=https://your-domain.in
SESSION_COOKIE_SECURE=1

# Business settings
BUSINESS_NAME=VehicleScan
PRODUCT_PRICE=400
PARTNER_COMMISSION_PER_STICKER=200
FREE_DELIVERY_CITY=Ahmedabad
FREE_DELIVERY_PIN_CODES=380001,380002,380003,380004,380005,380006,380007,380008,380009,380013,380014,380015,380016,380018,380019,380021,380022,380024,380026,380027,380028,380050,380051,380052,380054,380055,380058,380059,380060,380061,380063,380064,380015
DEFAULT_OTHER_DELIVERY_CHARGE=60
SUPPORT_PHONE=

# Razorpay: leave blank to disable live checkout until you configure your account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
